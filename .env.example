# Real Postgres connection string. Required for the app to run at all -
# locally, put this in a gitignored .env; on Vercel, set it under Project
# Settings -> Environment Variables (e.g. from Vercel Postgres or a Neon
# integration - either works, Prisma just needs a standard postgres:// URL).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Used only by `npm run seed:admin` (prisma/seedAdmin.ts) to bootstrap the
# very first admin account. Not loaded automatically - export these as real
# environment variables (shell, CI secret, hosting platform config) before
# running the command:
#
#   INITIAL_ADMIN_EMAIL=admin@example.com INITIAL_ADMIN_PASSWORD=... npm run seed:admin
#
# The script is idempotent: if an admin account already exists, it does
# nothing. There is no public admin registration anywhere in the app -
# every further admin account must be created by an already-logged-in admin.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
