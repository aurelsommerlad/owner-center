# Real Postgres connection string. Required for the app to run at all -
# locally, put this in a gitignored .env; on Vercel, set it under Project
# Settings -> Environment Variables (e.g. from Vercel Postgres or a Neon
# integration - either works, Prisma just needs a standard postgres:// URL).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# The very first admin account is bootstrapped from these two - and ONLY
# from these two. There is no public admin registration anywhere in the
# app. Two equivalent, idempotent ways to run the bootstrap once these are
# set (see src/server/adminBootstrapCore.ts for the shared logic both use):
#
#   1. From a terminal with DATABASE_URL configured:
#        npm run seed:admin
#   2. From any browser, no terminal/local setup at all - visit:
#        https://<your-deployment>/api/admin/bootstrap?token=<ADMIN_BOOTSTRAP_TOKEN>
#
# Either path does nothing if an admin account already exists - neither can
# ever create a second one.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Gates the GET /api/admin/bootstrap route above - without the matching
# `?token=` query param, that route responds 404 (indistinguishable from a
# route that doesn't exist). Set this to a long random value, e.g.:
#   openssl rand -hex 32
# Only needed if you intend to use the browser-based bootstrap path: pure
# CLI use of `npm run seed:admin` does not need this variable at all.
ADMIN_BOOTSTRAP_TOKEN=
