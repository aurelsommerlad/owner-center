# Real Postgres connection string. Required for the app to run at all -
# locally, put this in a gitignored .env; on Vercel, set it under Project
# Settings -> Environment Variables (e.g. from Vercel Postgres or a Neon
# integration - either works, Prisma just needs a standard postgres:// URL).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# The app's own public origin, no trailing slash (see src/lib/appUrl.ts).
# Used only to build absolute URLs - currently just invitation links
# (/invite/<token>). Set this ONLY on Vercel's Production environment, to
# the production domain:
#   APP_URL=https://owners.unique-places.com
# Leave unset everywhere else (Preview deployments, local dev): without it,
# the app falls back to the incoming request's own Host header, which is
# exactly right for a Preview deployment's own *.vercel.app URL or a local
# `next dev`/`next start` - so a Preview build never has to guess or share
# the production domain.
APP_URL=

# Not required for normal use. The first admin account is created through
# the web-based first-run setup at /admin/setup (visiting /admin with no
# admin account yet lands there automatically) - no environment variables
# needed for that path at all.
#
# These two are read ONLY by the optional `npm run seed:admin` CLI script
# (prisma/seedAdmin.ts), for deployments that prefer to provision the first
# admin via a terminal/CI step instead of ever visiting the setup page:
#   INITIAL_ADMIN_EMAIL=admin@example.com INITIAL_ADMIN_PASSWORD=... npm run seed:admin
# Whichever path runs first "wins" - both refuse to create a second admin
# once one exists, and there is no public admin registration anywhere.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# apaleo connection layer (src/server/integrations/apaleo). Server-only -
# never referenced from client code. Both credentials are required together;
# if either is missing, apaleo is simply treated as "nicht konfiguriert"
# (no crash, no owner-facing effect - the Owner Center itself still runs
# entirely on mock calendar/dashboard/statistics data).
#   APALEO_CLIENT_ID / APALEO_CLIENT_SECRET: your apaleo integration's OAuth2
#     client-credentials pair (from the apaleo Marketplace/Dev Portal).
#   APALEO_BASE_URL: apaleo's API base, defaults to https://api.apaleo.com -
#     only set this to point at a different apaleo API target.
APALEO_CLIENT_ID=
APALEO_CLIENT_SECRET=
APALEO_BASE_URL=

# Google Drive connection layer (src/server/integrations/googleDrive).
# Server-only - never referenced from client code. Owners never see a Google
# login; the app authenticates as a single Google service account and reads
# only a folder that account was explicitly given access to. All three
# values below are required together; if any is missing, Google Drive is
# simply treated as "nicht konfiguriert" (no crash, no owner-facing effect -
# this step only wires up the connection, no document sync/download yet).
#   GOOGLE_SERVICE_ACCOUNT_EMAIL: the service account's "client_email" from
#     its downloaded JSON key (Google Cloud Console -> IAM & Admin -> Service
#     Accounts -> Keys), e.g. name@project-id.iam.gserviceaccount.com.
#   GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY: the same JSON key's "private_key"
#     field, including the "-----BEGIN PRIVATE KEY-----"/"-----END PRIVATE
#     KEY-----" lines. On Vercel, paste it as a single line with literal
#     "\n" for each line break (the value is unescaped automatically) -
#     locally, either form works.
#   GOOGLE_DRIVE_ROOT_FOLDER_ID: the id of the Drive folder this app is
#     allowed to read (from that folder's URL:
#     https://drive.google.com/drive/folders/<THIS_PART>). That folder must
#     be shared with GOOGLE_SERVICE_ACCOUNT_EMAIL ("Viewer" is enough) -
#     the app never sees anything outside it.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
