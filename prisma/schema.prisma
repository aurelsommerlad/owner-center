// Real relational data store for the UNIQUE PLACES Owner Center / Admin
// area: Postgres, reached over the network via `@prisma/adapter-pg` (see
// src/server/db.ts). Started out as local SQLite during initial
// development, but that only works for a single-machine sandbox - a
// deployed target like Vercel runs stateless, read-only-filesystem
// serverless functions, which need a real network-reachable database.
// `DATABASE_URL` (see .env.example) is the one connection secret this
// needs; everything else about the schema/services below is provider-
// agnostic and unchanged.
//
// Only the models explicitly requested for this step are modeled here:
// User (login), Owner, OwnerUser (User <-> Owner link), Property,
// OwnerPropertyAccess (Owner <-> Property link), StatementDocument,
// GeneralDocument. Reservations, guests, occupancy, units, pricing and
// availability are deliberately NOT modeled here - they remain apaleo's
// domain and keep coming from the existing mock data under src/data/mock
// until that integration exists.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A login. Deliberately separate from Owner: a User is "who can sign in",
/// an Owner is "which company/eigentümer entity". `role` gates /admin vs the
/// Owner Center; an owner-role User is linked to exactly one Owner via
/// OwnerUser (see there for why several Users can share one Owner).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String
  /// Display name for admin-role users only (shown in the admin header).
  /// Owner-role users display OwnerUser.firstName/lastName instead.
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions  Session[]
  ownerUser OwnerUser?
}

/// A server-validated login session. The browser only ever holds this row's
/// id (in an httpOnly cookie) - never a token that encodes identity/claims
/// itself - so a session can be revoked (logout, deactivation) by deleting
/// or invalidating this row, and no signing secret exists anywhere.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  impersonations AdminImpersonation[]

  @@index([userId])
}

/// The contract partner / owner company. Deliberately not "one person" and
/// deliberately carries no login credentials of its own - see OwnerUser for
/// the individual logins under it (an owner can have several), and
/// OwnerPropertyAccess for the (many-to-many) link to properties.
model Owner {
  id          String   @id @default(cuid())
  name        String
  companyName String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerUsers         OwnerUser[]
  access             OwnerPropertyAccess[]
  statementDocuments StatementDocument[]
  generalDocuments   GeneralDocument[]
  impersonations     AdminImpersonation[]
}

/// Records one "Als Owner ansehen" admin preview: an admin (still
/// authenticated as themselves - see `sessionId`, always their own real
/// Session row, never an OwnerUser login) temporarily views the Owner
/// Center as `ownerId`. `endedAt` null means the preview is currently
/// active for that session; ending it sets `endedAt` rather than deleting
/// the row, so this doubles as the lightweight audit trail requested for
/// this step (adminUserId/ownerId/startedAt/endedAt) - not a full audit
/// system, just enough to know who previewed what and when.
///
/// `adminUserId` is deliberately a plain scalar, not a `User` relation:
/// this stays an audit-only reference and shouldn't widen User's relation
/// surface. See src/server/ownerContext.ts#getEffectiveOwnerContext, the
/// only place that reads this table to decide "which owner's data may this
/// request see".
model AdminImpersonation {
  id          String    @id @default(cuid())
  sessionId   String
  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  adminUserId String
  ownerId     String
  owner       Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  endedAt     DateTime?

  @@index([sessionId, endedAt])
}

/// An individual person with Owner Center access, belonging to exactly one
/// Owner (an owner can have several such users) and exactly one User login.
/// `status` gates Owner Center access independently of the underlying
/// User row, so "Nutzer deaktivieren" in admin never has to touch login
/// credentials themselves.
model OwnerUser {
  id          String    @id @default(cuid())
  ownerId     String
  owner       Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  status      String    @default("active")
  /// Fixed to "owner" for now - no per-user detail permissions yet.
  role        String    @default("owner")
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerId])
}

/// The connection/permission record for a property. Reservations, guests,
/// occupancy, units, pricing and availability are NOT modeled here and never
/// will be - those stay apaleo's domain and are fetched from there once that
/// integration exists. Admin only owns the identity + access side.
model Property {
  id                      String   @id @default(cuid())
  name                    String
  city                    String
  /// Not shown/edited in the admin form (which only has one "Standort"
  /// field, mapped to `city`) - carried through for the Owner Center's
  /// richer location display, set at seed/creation time.
  region                  String?
  status                  String   @default("active")
  /// The leading/authoritative link to apaleo: an admin-entered apaleo
  /// property id, deliberately never auto-matched by name. This internal
  /// Property row stays the source of truth for owner access - apaleo data
  /// is only ever reached by following this id, never the other way round.
  apaleoPropertyId        String?
  /// Mock configuration value only - no real Drive connection.
  statementsDriveFolderId String?
  /// Mock configuration value only - no real Drive connection.
  documentsDriveFolderId  String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  access             OwnerPropertyAccess[]
  statementDocuments StatementDocument[]
  generalDocuments   GeneralDocument[]
}

/// Many-to-many link between owners and properties: one owner can hold
/// several properties, and one property can be linked to several owners.
/// Never collapse this into a single `ownerId` field on Property.
///
/// `status` lets access be revoked without deleting the record (an audit
/// trail of who was ever granted access to what) - "removing" a property
/// from an owner in the admin UI sets this to "inactive" rather than
/// deleting the row. Every access/permission check only considers "active"
/// rows - see src/server/permissions.ts#canUserAccessProperty, the
/// server-side gate every property-scoped page and query goes through.
model OwnerPropertyAccess {
  id         String   @id @default(cuid())
  ownerId    String
  owner      Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  status     String   @default("active")
  createdAt  DateTime @default(now())

  @@unique([ownerId, propertyId])
}

/// A statement-archive document (Eigentümerreporting / Rechnung / Gutschrift
/// / other), synced in from Google Drive once that integration exists.
/// `adminStatus` is the admin-side publication lifecycle (draft -> ready ->
/// published/updated) and is separate from - and upstream of - the
/// owner-facing "Neu"/"Gesehen" status computed from the view/download
/// fields below: a document only becomes visible to an owner once it is
/// "published" or "updated" (see statementDocumentService.getStatementDocuments).
model StatementDocument {
  id           String   @id @default(cuid())
  ownerId      String
  owner        Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// 1-12
  month        Int
  year         Int
  /// "owner_report" | "invoice" | "credit_note" | "other"
  documentType String
  /// Only shown in the UI for "other" documents - the three fachlich
  /// defined types always display their fixed label instead.
  title        String
  fileName     String
  /// Google Drive file id. `null` until the Drive integration is wired up.
  driveFileId  String?
  /// Bumped whenever UNIQUE PLACES replaces this document with a corrected version.
  version      Int      @default(1)
  /// "draft" | "ready" | "published" | "updated"
  adminStatus  String   @default("draft")
  /// `null` while still a draft/not yet made available to the owner.
  publishedAt  DateTime?
  /// Most recent version replacement, if any - deliberately not
  /// Prisma's `@updatedAt` (which would fire on every view/download-count
  /// write below, which is not what this field means).
  updatedAt    DateTime?
  /// First time the owner opened this document since its last publish/update.
  firstViewedAt     DateTime?
  /// First download of the current version. Internal-only.
  firstDownloadedAt DateTime?
  /// Most recent download - shown to the owner.
  lastDownloadedAt  DateTime?
  /// Internal-only download counter.
  downloadCount     Int      @default(0)
  createdAt         DateTime @default(now())

  @@index([propertyId, year])
  @@index([ownerId])
}

/// Singleton row (fixed id) recording the result of the last "Verbindung
/// testen" action on /admin/integrations, so the admin UI can show a
/// "last successful check" timestamp across requests/serverless instances
/// instead of only ever reflecting the current request's live state.
/// Written only by src/server/integrations/apaleo - never read/written by
/// anything owner-facing.
model ApaleoConnectionCheck {
  id            String   @id @default("apaleo")
  checkedAt     DateTime @updatedAt
  success       Boolean
  propertyCount Int?
  errorMessage  String?
}

/// Same purpose/shape as ApaleoConnectionCheck above, for the Google Drive
/// connection layer (src/server/integrations/googleDrive) - a singleton row
/// recording the last "Verbindung testen" result on /admin/integrations.
model GoogleDriveConnectionCheck {
  id             String   @id @default("google-drive")
  checkedAt      DateTime @updatedAt
  success        Boolean
  rootFolderName String?
  itemCount      Int?
  errorMessage   String?
}

/// General documents outside the monthly statement cycle (contracts, tax
/// papers, insurance, ...). `propertyId`/`ownerId` are nullable: a document
/// can be uploaded before it has been assigned to either.
model GeneralDocument {
  id          String    @id @default(cuid())
  title       String
  /// "vertrag" | "steuerunterlage" | "objektunterlage" | "versicherung" | "sonstiges"
  category    String
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  ownerId     String?
  owner       Owner?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  fileName    String
  /// "draft" | "published"
  status      String    @default("draft")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}
